{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Talent": "Host=127.0.0.1;Port=5433;Username=postgres;Database=talent"
  },
  "Database": { "MigrateOnStartup": true },
  "Authentication": {
    "Mode": "Fake"
  },
  "Integration": {
    "CORE_HR": { "Mode": "Mock" },
    "Sync": { "RunOnStartup": true }
  },
  "Security": {
    "RoleSource": "TalentManaged",
    "Cookie": { "RequireSecure": false },
    "Seed": [
      { "Subject": "dev.manager", "EmployeeNumber": "E00001", "Roles": ["MANAGER"] },
      { "Subject": "dev.employee", "EmployeeNumber": "E00002", "Roles": ["EMPLOYEE"] },
      { "Subject": "dev.admin", "EmployeeNumber": "E00003", "Roles": ["HR_ADMIN"] },
      { "Subject": "dev.committee", "EmployeeNumber": "E00004", "Roles": ["TALENT_COMMITTEE"] }
    ]
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Talent": "Host=127.0.0.1;Port=5433;Username=postgres;Database=talent"
  },
  "Database": { "MigrateOnStartup": true },
  "Authentication": {
    "Mode": "Fake"
  },
  "Integration": {
    "CORE_HR": { "Mode": "Mock", "Mock": { "Seed": 7, "Employees": 12 } },
    "Sync": { "SyncOnStartupWhenEmpty": true }
  },
  "Security": {
    "RoleSource": "TalentManaged",
    "Cookie": { "RequireSecure": false },
    "Seed": [
      { "Subject": "dev.admin", "EmployeeId": "00000000-0000-0000-0000-0000000000a1", "Roles": ["HR_ADMIN"] },
      { "Subject": "dev.manager", "EmployeeId": "00000000-0000-0000-0000-0000000000a2", "Roles": ["MANAGER"] },
      { "Subject": "dev.employee", "EmployeeId": "00000000-0000-0000-0000-0000000000a3", "Roles": ["EMPLOYEE"] },
      { "Subject": "dev.committee", "EmployeeId": "00000000-0000-0000-0000-0000000000a4", "Roles": ["TALENT_COMMITTEE"] }
    ]
  }
}

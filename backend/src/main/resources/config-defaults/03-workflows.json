     "to": "APPROVED",
     "label": "Approve",
     "commentRequired": false,
     "system": false
    },
    {
     "from": "SUBMITTED",
     "action": "RETURN",
     "to": "DRAFT",
     "label": "Return to reviewer",
     "commentRequired": true,
     "system": false
    },
    {
     "from": "APPROVED",
     "action": "CALIBRATE",
     "to": "CALIBRATED",
     "label": "Confirm board decision",
     "commentRequired": false,
     "system": false
    },
    {
     "from": "APPROVED",
     "action": "RETURN",
     "to": "DRAFT",
     "label": "Send back to reviewer",
     "commentRequired": true,
     "system": false
    },
    {
     "from": "CALIBRATED",
     "action": "REOPEN",
     "to": "APPROVED",
     "label": "Reopen board review",
     "commentRequired": true,
     "system": true
    },
    {
     "from": "CALIBRATED",
     "action": "PUBLISH",
     "to": "FINAL",
     "label": "Publish",
     "commentRequired": false,
     "system": true
    },
    {
     "from": "DRAFT",
     "action": "WITHDRAW",
     "to": "WITHDRAWN",
     "label": "Withdraw",
     "commentRequired": true,
     "system": true
    },
    {
     "from": "SUBMITTED",
     "action": "WITHDRAW",
     "to": "WITHDRAWN",
     "label": "Withdraw",
     "commentRequired": true,
     "system": true
    },
    {
     "from": "APPROVED",
     "action": "WITHDRAW",
     "to": "WITHDRAWN",
     "label": "Withdraw",
     "commentRequired": true,
     "system": true
    }
   ]
  }
 },

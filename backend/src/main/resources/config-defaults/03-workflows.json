    {
     "code": "FINAL",
     "label": "Final",
     "actor": null,
     "slaDays": null,
     "terminal": true
    },
    {
     "code": "WITHDRAWN",
     "label": "Withdrawn",
     "actor": null,
     "slaDays": null,
     "terminal": true
    }
   ],
   "transitions": [
    {
     "from": "DRAFT",
